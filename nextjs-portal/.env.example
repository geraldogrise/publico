# Banco de dados (SQLite via Prisma)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Gere um segredo com: openssl rand -base64 32
NEXTAUTH_SECRET="coloque-um-segredo-forte-aqui"

# OAuth 2.0 (opcional) — preencha para habilitar login social
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SAML (opcional) — registre o SP em um IdP (ex.: https://samltest.id)
SAML_ENTRY_POINT=
SAML_ISSUER=nextjs-portal-sp
SAML_CALLBACK_URL=http://localhost:3000/api/saml/acs
SAML_IDP_CERT=
